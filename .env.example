JIRA_BASE_URL=https://<your-organization>.atlassian.net
JIRA_EMAIL=<your-email>@example.com
JIRA_API_TOKEN=<your-api-token>
PORT=3001
RCI_FIELD_NAME=Requirement Clarity Index
STORY_POINTS_FIELD_NAME=Story Points
HOST_PASSWORD=changeme

# Store backend: true (or unset) = in-memory (no database, resets on restart).
# false = MongoDB-backed (see docs/DESIGN.md §3 for the schema).
ENABLE_IN_MEMORY_STORE=true

# Only used when ENABLE_IN_MEMORY_STORE=false
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=open_scrum_poker
MONGODB_ROOM_TTL_SECONDS=172800

# "Login with Atlassian" for the host, instead of HOST_PASSWORD. false (or unset) = today's
# password flow. true = redirect the host to Atlassian OAuth; HOST_PASSWORD is then unused.
ENABLE_ATLASSIAN_LOGIN=false

# Only used when ENABLE_ATLASSIAN_LOGIN=true — register an OAuth 2.0 (3LO) app at
# https://developer.atlassian.com/console/myapps/
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
ATLASSIAN_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/atlassian/callback
# Comma-separated allowlist, e.g. company.com,partner.com — leave blank to allow ANY
# Atlassian account with a verified email (not recommended for anything but local testing).
ATLASSIAN_ALLOWED_EMAIL_DOMAINS=

# When a final value is synced to Jira, also post a comment on the issue attributing
# who actually set it (the field write itself always runs as the service account, so
# without this Jira's own changelog just shows JIRA_EMAIL as the author). Prefers the
# host's Atlassian email (if ENABLE_ATLASSIAN_LOGIN got them one), else their display name.
ENABLE_JIRA_ATTRIBUTION_COMMENT=false
